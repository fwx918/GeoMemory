{
  "name": "chronotrace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "时迹 ChronoTrace — 站在现在，看见从前。A time-space exploration web app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --config vite.config.artifact.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "geo:build": "node scripts/geo/build.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
